{
  "name": "ai-short-generator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "generate": "tsx src/cli.ts",
    "check": "biome check --error-on-warnings . && pnpm typecheck",
    "setup:local": "bash scripts/setup-local.sh",
    "setup:voice": "bash scripts/setup-voice.sh",
    "studio": "vite",
    "build": "vite build",
    "studio:preview": "vite preview",
    "typecheck": "tsc",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mantine/core": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@remotion/bundler": "4.0.547",
    "@remotion/player": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
