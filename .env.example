# Loaded only by --paid-topic. Set a provider for all stages, or pick them separately.
# PAID_PROVIDER=openai
# SCRIPT_PROVIDER=openrouter
# IMAGE_PROVIDER=fal
# VOICE_PROVIDER=kokoro

OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# FAL_KEY=
# ELEVENLABS_API_KEY=

# Choose model IDs for the selected stages. Official OpenAI has built-in defaults.
# SCRIPT_MODEL=anthropic/claude-sonnet-4.6
# IMAGE_MODEL=xai/grok-imagine-image
# VOICE_MODEL=eleven_multilingual_v2
# VOICE=your_provider_voice_id

# Custom OpenAI-compatible endpoint. For separate endpoints use SCRIPT_BASE_URL,
# IMAGE_BASE_URL, and VOICE_BASE_URL, with matching *_API_KEY overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1

# IMAGE_SIZE=1024x1536
# IMAGE_ASPECT_RATIO=9:16
# IMAGE_OPTIONS='{"image_size":"portrait_16_9"}'
# VOICE_FORMAT=mp3
