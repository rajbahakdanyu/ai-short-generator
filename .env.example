# Read only when --paid-topic is used.
OPENAI_API_KEY=
# Defaults below apply to the official OpenAI endpoint. For another provider,
# replace the URL and model IDs with values that provider supports.
OPENAI_BASE_URL=https://api.openai.com/v1
SCRIPT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1-mini
VOICE_MODEL=gpt-4o-mini-tts
VOICE=onyx
# Optional. The official GPT Image models default to 1024x1536.
# IMAGE_SIZE=1024x1536
